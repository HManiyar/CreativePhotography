@using CreativePhotography.Content

@{
    ViewData["Title"] = "Album Design";
    Layout = "~/Views/Shared/_SharedUserView.cshtml";
}

<link href="~/css/customcss/FlexibleImageGalleryStyles.css" rel="stylesheet" />

@{
    string[] imageNames = { "Classic_Album.jpg", "Ambiance_Album.jpg", "Fusion_Album.jpg", "Traditional_Album.jpg" };
    string[] textheaders = { "Classic Clean", "Ambiance", "Fusion", "Traditional" };
    string[] imageTexts = {
        "Stylistic design elements kept at a minimum to maintain focus on the images. Backgrounds are primarily black or white with subtle border adornments.",
        "Incorporates images into the background at varying degrees of opacity and fades — frequent or minimal, tailored entirely to the client's needs.",
        "Our most vivid layout — textures, patterns, adornments, edge fades, and border effects that give a distinctive vintage character to the images.",
        "Adds embellishments to enhance the overall design. Subtle or generous, the goal is to complement the images without overwhelming them."
    };
    string[] headerLinks = {
        Url.Action("ClassicClean", "AlbumDesign"),
        Url.Action("Ambaince", "AlbumDesign"),
        Url.Action("Fusion", "AlbumDesign"),
        Url.Action("Traditional", "AlbumDesign")
    };
}

<div class="col-12 text-center">
    <h2 class="heading">@PageHeaders.AlbumDesign</h2>
</div>

<div class="cd-cat-grid cd-cat-grid--2">
    @for (int i = 0; i < imageNames.Length; i++)
    {
        <a href="@headerLinks[i]" class="cd-cat-card">
            <div class="cd-cat-card__thumb">
                <img src="/images/Thumbnails/Parent_Album_Thumbnail/@imageNames[i]" alt="@textheaders[i]">
            </div>
            <div class="cd-cat-card__body">
                <h3 class="cd-cat-card__title">@textheaders[i]</h3>
                <p class="cd-cat-card__desc">@imageTexts[i]</p>
                <span class="cd-cat-card__cta">Explore &rarr;</span>
            </div>
        </a>
    }
</div>

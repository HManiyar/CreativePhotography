@using PixelCreator.Content

@{
    ViewData["Title"] = "Videos";
    Layout = "~/Views/Shared/_SharedUserView.cshtml";
}

<script src="/js/jquery-3.3.1.min.js"></script>
<script src="/js/CustomJS/Videos.js"></script>

<style>
    /* ── Video grid ───────────────────────────────────────────── */
    .cd-video-section {
        padding: 0 0 5rem;
    }

    .cd-video-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .cd-vid-card {
        position: relative;
        border: none;
        background: #111;
        overflow: hidden;
        cursor: pointer;
    }

    /* ── Thumbnail ────────────────────────────────────────────── */
    .cd-vid-card__thumb {
        position: relative;
        overflow: hidden;
    }

    .cd-vid-card__thumb img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                    opacity 0.4s ease;
    }

    .cd-vid-card:hover .cd-vid-card__thumb img {
        transform: scale(1.06);
        opacity: 0.7;
    }

    /* ── Dark gradient overlay ────────────────────────────────── */
    .cd-vid-card__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0) 40%,
            rgba(0, 0, 0, 0.72) 100%
        );
        pointer-events: none;
        transition: background 0.35s ease;
    }

    .cd-vid-card:hover .cd-vid-card__overlay {
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.2) 0%,
            rgba(0, 0, 0, 0.82) 100%
        );
    }

    /* ── Play button ──────────────────────────────────────────── */
    .cd-vid-card__play {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -60%) scale(0.9);
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.18);
        border: 2px solid rgba(255, 255, 255, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.75;
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                    opacity 0.3s ease,
                    background 0.3s ease,
                    border-color 0.3s ease;
        pointer-events: none;
    }

    .cd-vid-card__play svg {
        width: 22px;
        height: 22px;
        fill: #fff;
        margin-left: 3px;
    }

    .cd-vid-card:hover .cd-vid-card__play {
        transform: translate(-50%, -60%) scale(1.1);
        opacity: 1;
        background: rgba(239, 214, 134, 0.22);
        border-color: #efd686;
    }

    /* ── Title strip ──────────────────────────────────────────── */
    .cd-vid-card__title {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0.85rem 1.1rem;
        font-family: 'Oswald', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #fff;
        pointer-events: none;
        transition: color 0.25s ease;
    }

    .cd-vid-card:hover .cd-vid-card__title {
        color: #efd686;
    }

    /* ── Modal overrides ──────────────────────────────────────── */
    .cd-video-modal .modal-content {
        background: #0a0a0a;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0;
    }

    .cd-video-modal .modal-header {
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        padding: 1rem 1.25rem;
    }

    .cd-video-modal .modal-title {
        font-family: 'Oswald', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #efd686;
    }

    .cd-video-modal .close {
        color: rgba(255, 255, 255, 0.7);
        text-shadow: none;
        opacity: 1;
        font-size: 1.4rem;
        transition: color 0.2s;
    }

    .cd-video-modal .close:hover { color: #fff; }

    .cd-video-modal .modal-body { padding: 0; }

    .cd-video-modal .modal-footer {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 0.75rem 1.25rem;
    }

    .cd-video-modal .btn-secondary {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: rgba(255, 255, 255, 0.7);
        font-family: 'Inter', sans-serif;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        border-radius: 0;
        padding: 0.5rem 1.4rem;
        transition: border-color 0.2s, color 0.2s;
    }

    .cd-video-modal .btn-secondary:hover {
        border-color: #efd686;
        color: #efd686;
        background: transparent;
    }

    /* ── Responsive ───────────────────────────────────────────── */
    @@media (max-width: 992px) {
        .cd-video-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 576px) {
        .cd-video-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
            padding: 0 1rem;
        }
    }
</style>


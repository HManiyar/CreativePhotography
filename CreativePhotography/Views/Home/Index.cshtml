@using PixelCreator.Content
@{
    Layout = "~/Views/Shared/_SharedUserView.cshtml";
    string[] originalImagePaths = (ViewBag.OriginalImagePaths as string[]) ?? Array.Empty<string>();
}

<!DOCTYPE html>
<html>
<head>
    <link href="~/css/customcss/HeroSlider.css" rel="stylesheet" />
</head>
<body>

    @* ── Hero Slider (curated static images) ─────────────────── *@
    <section class="hero-slider-section">
        <div id="heroCarousel" class="carousel slide carousel-fade"
             data-ride="carousel" data-interval="5500">

            <ol class="carousel-indicators">
                <li data-target="#heroCarousel" data-slide-to="0" class="active"></li>
                <li data-target="#heroCarousel" data-slide-to="1"></li>
                <li data-target="#heroCarousel" data-slide-to="2"></li>
                <li data-target="#heroCarousel" data-slide-to="3"></li>
                <li data-target="#heroCarousel" data-slide-to="4"></li>
            </ol>

            <div class="carousel-inner">

                <div class="carousel-item active">
                    <div class="hero-slide">
                        <img class="hero-bg" src="/images/Wed.jpg" alt="Wedding Photography"
                             fetchpriority="high" decoding="sync">
                        <div class="hero-overlay"></div>
                        <div class="hero-content">
                            <span class="hero-tagline">Wedding Photography</span>
                            <h1 class="hero-title">Love Stories<br>Beautifully Told</h1>
                            <p class="hero-subtitle">Timeless wedding memories crafted with artistry</p>
                            <a href="#section-contact" class="hero-cta smoothscroll">Book a Session</a>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="hero-slide">
                        <img class="hero-bg" src="/images/Pre_Wed.jpg" alt="Pre-Wedding Sessions"
                             decoding="async">
                        <div class="hero-overlay"></div>
                        <div class="hero-content">
                            <span class="hero-tagline">Pre-Wedding Sessions</span>
                            <h1 class="hero-title">Before The<br>Big Day</h1>
                            <p class="hero-subtitle">Celebrate your love story before the ceremony</p>
                            <a href="#section-contact" class="hero-cta smoothscroll">Book a Session</a>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="hero-slide">
                        <img class="hero-bg" src="/images/Engagement.jpg" alt="Engagement Photography"
                             decoding="async">
                        <div class="hero-overlay"></div>
                        <div class="hero-content">
                            <span class="hero-tagline">Engagement Photography</span>
                            <h1 class="hero-title">The Beginning<br>Of Forever</h1>
                            <p class="hero-subtitle">Capturing the joy of saying yes</p>
                            <a href="#section-contact" class="hero-cta smoothscroll">Book a Session</a>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="hero-slide">
                        <img class="hero-bg" src="/images/Decoration.jpg" alt="Event Decoration"
                             decoding="async">
                        <div class="hero-overlay"></div>
                        <div class="hero-content">
                            <span class="hero-tagline">Event Decoration</span>
                            <h1 class="hero-title">Transform<br>Your Vision</h1>
                            <p class="hero-subtitle">Breathtaking setups for every occasion</p>
                            <a href="#section-contact" class="hero-cta smoothscroll">Book a Session</a>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <div class="hero-slide">
                        <img class="hero-bg" src="/images/Bday.jpg" alt="Birthday Celebrations"
                             decoding="async">
                        <div class="hero-overlay"></div>
                        <div class="hero-content">
                            <span class="hero-tagline">Birthday Celebrations</span>
                            <h1 class="hero-title">Every Milestone<br>Deserves To Shine</h1>
                            <p class="hero-subtitle">Creating memories that last a lifetime</p>
                            <a href="#section-contact" class="hero-cta smoothscroll">Book a Session</a>
                        </div>
                    </div>
                </div>

            </div>

            <a class="carousel-control-prev" href="#heroCarousel" role="button" data-slide="prev">
                <span class="hero-arrow" aria-hidden="true">&#8592;</span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" href="#heroCarousel" role="button" data-slide="next">
                <span class="hero-arrow" aria-hidden="true">&#8594;</span>
                <span class="sr-only">Next</span>
            </a>
        </div>

        <div class="scroll-indicator" aria-hidden="true">
            <span>Scroll</span>
            <div class="scroll-line"></div>
        </div>
    </section>

    @* ── Services Section ─────────────────────────────────────── *@
    <section class="services-section" id="section-services">

        <div class="services-header" data-aos="fade-up" data-aos-duration="750">
            <span class="cd-eyebrow">What We Do</span>
            <h2 class="services-title">Our Services</h2>
            <div class="portfolio-divider"></div>
        </div>

        <div class="services-grid">

            <div class="service-card" data-aos="fade-up" data-aos-delay="0" data-aos-duration="700">
                <div class="service-icon-wrap">
                    <svg viewBox="0 0 24 24">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                        <circle cx="12" cy="13" r="4"/>
                    </svg>
                </div>
                <h3 class="service-card__title">Wedding Photography</h3>
                <p class="service-card__desc">Timeless moments beautifully captured on your most special day.</p>
                <a href="@Url.Action("Wedding", "Photography")" class="service-card__link">Explore</a>
            </div>

            <div class="service-card" data-aos="fade-up" data-aos-delay="90" data-aos-duration="700">
                <div class="service-icon-wrap">
                    <svg viewBox="0 0 24 24">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                </div>
                <h3 class="service-card__title">Pre-Wedding Sessions</h3>
                <p class="service-card__desc">Celebrate your love story beautifully before the big ceremony begins.</p>
                <a href="@Url.Action("PreWedding", "Photography")" class="service-card__link">Explore</a>
            </div>

            <div class="service-card" data-aos="fade-up" data-aos-delay="180" data-aos-duration="700">
                <div class="service-icon-wrap">
                    <svg viewBox="0 0 24 24">
                        <path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4z"/>
                        <line x1="8" y1="2" x2="8" y2="18"/>
                        <line x1="16" y1="6" x2="16" y2="22"/>
                    </svg>
                </div>
                <h3 class="service-card__title">Engagement Photography</h3>
                <p class="service-card__desc">Capturing the joy and excitement of saying yes forever.</p>
                <a href="@Url.Action("Engagement", "Photography")" class="service-card__link">Explore</a>
            </div>

            <div class="service-card" data-aos="fade-up" data-aos-delay="0" data-aos-duration="700">
                <div class="service-icon-wrap">
                    <svg viewBox="0 0 24 24">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                </div>
                <h3 class="service-card__title">Event Decoration</h3>
                <p class="service-card__desc">Breathtaking décor setups for birthdays, anniversaries &amp; every occasion.</p>
                <a href="@Url.Action("Decoration", "Photography")" class="service-card__link">Explore</a>
            </div>

            <div class="service-card" data-aos="fade-up" data-aos-delay="90" data-aos-duration="700">
                <div class="service-icon-wrap">
                    <svg viewBox="0 0 24 24">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                    </svg>
                </div>
                <h3 class="service-card__title">Album Design</h3>
                <p class="service-card__desc">Premium, bespoke albums crafted to tell your story beautifully.</p>
                <a href="@Url.Action("AlbumDesign", "Home")" class="service-card__link">Explore</a>
            </div>

            <div class="service-card" data-aos="fade-up" data-aos-delay="180" data-aos-duration="700">
                <div class="service-icon-wrap">
                    <svg viewBox="0 0 24 24">
                        <line x1="4"  y1="21" x2="4"  y2="14"/>
                        <line x1="4"  y1="10" x2="4"  y2="3"/>
                        <line x1="12" y1="21" x2="12" y2="12"/>
                        <line x1="12" y1="8"  x2="12" y2="3"/>
                        <line x1="20" y1="21" x2="20" y2="16"/>
                        <line x1="20" y1="12" x2="20" y2="3"/>
                        <line x1="1"  y1="14" x2="7"  y2="14"/>
                        <line x1="9"  y1="8"  x2="15" y2="8"/>
                        <line x1="17" y1="16" x2="23" y2="16"/>
                    </svg>
                </div>
                <h3 class="service-card__title">Photo Editing</h3>
                <p class="service-card__desc">Professional retouching and creative edits to perfect every frame.</p>
                <a href="@Url.Action("PhotoEditing", "Home")" class="service-card__link">Explore</a>
            </div>

        </div>
    </section>

    @* ── Stats / Numbers Strip ────────────────────────────────── *@
    <section class="stats-section">
        <div class="stats-inner">

            <div class="stat-item" data-aos="fade-up" data-aos-delay="0" data-aos-duration="700">
                <div class="stat-value">
                    <span class="stat-number" data-target="500">0</span>
                    <span class="stat-suffix">+</span>
                </div>
                <span class="stat-label">Wedding Shoots</span>
            </div>

            <div class="stat-item" data-aos="fade-up" data-aos-delay="100" data-aos-duration="700">
                <div class="stat-value">
                    <span class="stat-number" data-target="10">0</span>
                    <span class="stat-suffix">+</span>
                </div>
                <span class="stat-label">Years Experience</span>
            </div>

            <div class="stat-item" data-aos="fade-up" data-aos-delay="200" data-aos-duration="700">
                <div class="stat-value">
                    <span class="stat-number" data-target="1200">0</span>
                    <span class="stat-suffix">+</span>
                </div>
                <span class="stat-label">Happy Clients</span>
            </div>

            <div class="stat-item" data-aos="fade-up" data-aos-delay="300" data-aos-duration="700">
                <div class="stat-value">
                    <span class="stat-number" data-target="400">0</span>
                    <span class="stat-suffix">+</span>
                </div>
                <span class="stat-label">Albums Designed</span>
            </div>

        </div>
    </section>

    @* ── Portfolio Gallery ────────────────────────────────────── *@
    @if (originalImagePaths.Length > 0)
    {
        <section class="portfolio-section">
            <div class="portfolio-header">
                <span class="cd-eyebrow"
                      data-aos="fade-up" data-aos-duration="700">Our Portfolio</span>
                <h2 class="portfolio-title"
                    data-aos="fade-up" data-aos-delay="100" data-aos-duration="700">@PageHeaders.Home</h2>
                <div class="portfolio-divider"
                     data-aos="fade-right" data-aos-delay="260" data-aos-duration="700"></div>
            </div>

            <div class="masonry-gallery">
                @for (int i = 0; i < originalImagePaths.Length; i++)
                {
                    <div class="masonry-item"
                         data-aos="fade-up"
                         data-aos-delay="@((i % 6) * 70)"
                         data-aos-duration="650">
                        <a href="@Url.Content(originalImagePaths[i])" data-fancybox="gallery">
                            <img src="@Url.Content(originalImagePaths[i])"
                                 alt="Pixel Creator Portfolio"
                                 loading="@(i < 6 ? "eager" : "lazy")">
                            <div class="masonry-overlay">
                                <span class="masonry-zoom-icon">&#43;</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </section>
    }

    @* ── Counter animation (vanilla JS, no jQuery needed) ──────── *@
    <script>
        (function () {
            if (!('IntersectionObserver' in window)) return;

            function easeOutQuart(t) {
                return 1 - Math.pow(1 - t, 4);
            }

            function animateCount(el, target, duration) {
                var start = null;
                function tick(ts) {
                    if (!start) start = ts;
                    var progress = Math.min((ts - start) / duration, 1);
                    el.textContent = Math.round(easeOutQuart(progress) * target);
                    if (progress < 1) {
                        requestAnimationFrame(tick);
                    } else {
                        el.textContent = target;
                    }
                }
                requestAnimationFrame(tick);
            }

            var counters = document.querySelectorAll('.stat-number[data-target]');
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) {
                        var target = parseInt(e.target.getAttribute('data-target'), 10);
                        animateCount(e.target, target, 1800);
                        io.unobserve(e.target);
                    }
                });
            }, { threshold: 0.6 });

            counters.forEach(function (c) { io.observe(c); });

            /* 3D tilt on service cards (pointer devices only) */
            if (window.matchMedia('(hover: hover)').matches) {
                document.querySelectorAll('.service-card').forEach(function (card) {
                    card.addEventListener('mousemove', function (e) {
                        var r  = card.getBoundingClientRect();
                        var x  = (e.clientX - r.left  - r.width  / 2) / r.width  * 9;
                        var y  = (e.clientY - r.top   - r.height / 2) / r.height * -9;
                        card.style.transform =
                            'perspective(900px) rotateX(' + y + 'deg) rotateY(' + x + 'deg) translateY(-8px)';
                    });
                    card.addEventListener('mouseleave', function () {
                        card.style.transform = '';
                    });
                });
            }
        })();
    </script>

</body>
</html>

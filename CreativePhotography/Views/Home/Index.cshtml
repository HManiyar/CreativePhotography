@using CreativePhotography.Content
@{
    Layout = "~/Views/Shared/_SharedUserView.cshtml";
    string[] originalImagePaths = (ViewBag.OriginalImagePaths as string[]) ?? Array.Empty<string>();
    string[] compressedImagePaths = (ViewBag.CompressedImagePaths as string[]) ?? Array.Empty<string>();

}

 <section class="site-section-hero bg-image mb-5" style="background-image: url('/images/creative-logo.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat; min-height: 100vh; display: flex; align-items: center; width: 100%;">
            <div class="container">
                <div class="row justify-content-center align-items-center">
                    <div class="col-md-7 text-center">
                        <h1 class="heading text-uppercase text-white" data-aos="fade-up">@WebsiteData.webTitle</h1>
                    </div>
                </div>
            </div>
</section>
<!DOCTYPE html>
<html>
<head>
	<link href="~/css/customcss/FlexibleImageGalleryStyles.css" rel="stylesheet" />
</head>
<body>
    <div class="col-12 text-center">
        <h2 class="heading">@PageHeaders.Home</h2>
    </div>
	<div class="album-container">
		<div class="album-inner">
			@for (int i = 0; i < originalImagePaths.Length; i++)
			{
				<div class="album-item">
					<a href="@Url.Content(originalImagePaths[i])" data-fancybox="gallery">
						<img src="@Url.Content(originalImagePaths[i])" alt="Image" class="img-fluid mb-0">
					</a>
				</div>
			}
		</div>
	</div>
</body>
</html>
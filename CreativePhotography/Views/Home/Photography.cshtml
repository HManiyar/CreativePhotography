@using PixelCreator.Content

@{
    ViewData["Title"] = "Photography";
    Layout = "~/Views/Shared/_SharedUserView.cshtml";
}

<link href="~/css/customcss/FlexibleImageGalleryStyles.css" rel="stylesheet" />

@{
    string[] imageNames = {
        "Pre_Wed.jpg", "Engagement.jpg", "Wed.jpg",
        "BabyBump.jpg", "Bday.jpg", "Decoration.jpg",
        "Photoshoot.jpg",
        "IndustrialPhotoshoot.jpg"
    };
    string[] textheaders = {
        "Pre-Wedding", "Engagement", "Wedding",
        "Maternity Shoot", "Birthday", "Decoration",
        "Product Photoshoot", "Industrial Photoshoot"
    };
    string[] imageTexts = {
        "Capture the essence of your love before the big day. Intimate, candid sessions that tell your story together.",
        "Celebrate the joy of engagement with elegant and heartwarming photographs that capture the excitement of your journey.",
        "Relive the magic of your wedding day. We specialise in capturing every precious moment so your memories last a lifetime.",
        "Welcome your bundle of joy with beautifully composed maternity photography celebrating this extraordinary time.",
        "From the first birthday to milestone celebrations — vibrant photographs that capture the joy of every special moment.",
        "Transform your event with stunning detail photography, from floral arrangements to every intricate decoration.",
        "Studio-grade product photography for e-commerce, packaging, food, and lifestyle brands — crafted to captivate.",
        "Powerful industrial and aerial photography that captures the scale, precision, and story of your facility."
    };
    string[] headerLinks = {
        Url.Action("PreWedding", "Photography") ?? "",
        Url.Action("Engagement", "Photography") ?? "",
        Url.Action("Wedding", "Photography") ?? "",
        Url.Action("BabyShower", "Photography") ?? "",
        Url.Action("Birthday", "Photography") ?? "",
        Url.Action("Decoration", "Photography") ?? "",
        Url.Action("Photoshoot", "Photography") ?? "",
        Url.Action("IndustrialPhotoshoot", "Photography") ?? ""
    };
}

<div class="col-12 text-center">
    <h2 class="heading">@PageHeaders.PhotoGraphy</h2>
</div>

<div class="cd-cat-grid cd-cat-grid--3">
    @for (int i = 0; i < imageNames.Length; i++)
    {
        <a href="@headerLinks[i]" class="cd-cat-card">
            <div class="cd-cat-card__thumb">
                <img src="/images/@imageNames[i]" alt="@textheaders[i]">
            </div>
            <div class="cd-cat-card__body">
                <h3 class="cd-cat-card__title">@textheaders[i]</h3>
                <p class="cd-cat-card__desc">@imageTexts[i]</p>
                <span class="cd-cat-card__cta">View Gallery &rarr;</span>
            </div>
        </a>
    }
</div>

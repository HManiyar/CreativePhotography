@using CreativePhotography.Content
@{
	ViewData["Title"] = "About";
	Layout = "~/Views/Shared/_SharedUserView.cshtml";
}
<div class="row mb-3">
	<div class="col-12 text-center">
		<h2 class="heading">@PageHeaders.About</h2>
	</div>
</div>
<section class="site-section" id="section-about">
	<div class="container">
		<div class="row justify-content-center">

			<div class="col-md-8">
				<div data-aos="fade-up" data-aos-delay="100">
					<div style="text-align: justify; font-family: Arial, sans-serif; line-height: 1.6;">
						<p>Creative Design is more than design studio.We always keep in mind while designing of album that photography aesthetic values of photographs and art of photographers should always be in focus not designer.</p>
						 <p> We provide to photographers with both classic and uniquely modern designs that meet the current trends of album presentation. Our design and editing  are support to enhance color balancing and contrast of images.  We customize design according to client&rsquo;s requirement. Whether one is looking at the artistic handmade covers, professional binding, unique cameos, or dramatic album design the stunning quality and innovation of these albums will beyond  the expectations of both you and your clients. <br /></p>
					 </div>
					<div style="display: flex; flex-wrap: wrap; justify-content: space-between;">

                        <div style="flex: 0 0 48%; margin-bottom: 20px;">
                            <h3 class="mt-5">Services</h3>
                            <ul class="ul-check list-unstyled primary">
                                <li>Design</li>
                                <li>Print</li>
                                <li>Photo Editing & Retouching</li>
                            </ul>
                        </div>

                        <div style="flex: 0 0 48%; margin-bottom: 20px;">
                            <h3 class="mt-5">Design Styles</h3>
                            <ul class="ul-check list-unstyled primary">
                                <li>Classic Clean</li>
                                <li>Ambiance</li>
                                <li>Fusion</li>
                                <li>Traditional</li>
                            </ul>
                        </div>

                    </div>

				</div>
			</div>
		</div>
	</div>
</section>


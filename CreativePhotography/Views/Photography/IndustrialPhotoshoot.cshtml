@using PixelCreator.Content

@{
    ViewBag.ActiveGallery = "IndustrialPhotoshoot";
    Layout = "~/Views/Shared/_SharedUserView.cshtml";
    string[] originalImagePaths = (ViewBag.OriginalImagePaths as string[]) ?? Array.Empty<string>();
    string[] allImagePaths = (ViewBag.AllImagePaths as string[]) ?? Array.Empty<string>();
    int pageStartIndex = (int)(ViewBag.PageStartIndex ?? 0);
}
<!DOCTYPE html>
<html>
<head>
    <link href="~/css/customcss/FlexibleImageGalleryStyles.css" rel="stylesheet" />
</head>
<body>
    <div class="col-12 text-center">
        <h2 class="heading">@PageHeaders.IndustrialPhotoshoot</h2>
    </div>
@await Html.PartialAsync("_PhotographyNav")
    <div class="album-container">
        <div class="album-inner">
            @for (int i = 0; i < originalImagePaths.Length; i++)
            {
                <div class="album-item">
                    <a href="@Url.Content(originalImagePaths[i])" data-fancybox="gallery">
                        <img src="@Url.Content(originalImagePaths[i])" alt="Industrial Photoshoot" class="img-fluid mb-0">
                    </a>
                </div>
            }
        </div>
    </div>
    <script>
        window.mvAllImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allImagePaths));
        window.mvPageStartIndex = @pageStartIndex;
    </script>
</body>
</html>

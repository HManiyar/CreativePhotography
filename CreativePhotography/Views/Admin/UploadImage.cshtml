@using PixelCreator.Content
@{
    ViewData["Title"] = "UploadImage";
    Layout = "~/Views/Shared/_SharedAdminView.cshtml";
}
  <script src="/js/jquery-3.3.1.min.js"></script> 
<script src="/js/CustomJS/UploadImage.js"></script>
<div class="row mb-3">
    <div class="col-12 text-center">
        <h2 class="heading">@PageHeaders.UploadImages</h2>
    </div>
</div>
<section class="site-section">
<div class="container">
    <form id="uploadForm" method="post" enctype="multipart/form-data" action="@Url.Action("HandleUpload", "Admin")">
        <div class="form-group">
            <label for="categorySelect">Category:</label>
            <select id="categorySelect" class="form-control">
                <option value="0" selected>None</option>
            </select>
        </div>
        <div class="form-group">
            <label for="subCategorySelect">SubCategory:</label>
            <select id="subCategorySelect" class="form-control">
                 <option value="0" selected>None</option>
            </select>
        </div>
        <div class="form-group">
            <label for="fileUpload">Select Files:</label>
            <input type="file" id="fileUpload" name="files" multiple class="form-control-file" />
        </div>
        <button type="submit" class="btn btn-primary">Upload</button>
    </form>
</div>
</section>